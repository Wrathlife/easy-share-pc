<Window x:Class="EasyShare.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Netshare"
        Height="560" Width="480"
        MinHeight="480" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
  <DockPanel Margin="24">
    <TextBlock DockPanel.Dock="Top" Text="Netshare" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock DockPanel.Dock="Top" Text="Device-to-device file sharing — no account, no ads."
               Foreground="#55606A" Margin="0,0,0,20" TextWrapping="Wrap"/>

    <StackPanel x:Name="HomePanel">
      <Button Content="Share files" Height="48" Margin="0,0,0,12" Click="OnShareClick"/>
      <Button Content="Receive files" Height="48" Click="OnReceiveClick"/>
      <TextBlock Text="{Binding Status}" Margin="0,24,0,0" TextWrapping="Wrap" Foreground="#334"/>
    </StackPanel>

    <StackPanel x:Name="SharePanel" Visibility="Collapsed">
      <Button Content="← Back" HorizontalAlignment="Left" Margin="0,0,0,12" Click="OnBackHome" Padding="8,4"/>
      <Button Content="Pick files…" Height="40" Margin="0,0,0,12" Click="OnPickFiles"/>
      <CheckBox x:Name="EncryptToggle" Content="Encrypt via MQTT (skip WebRTC)" Margin="0,0,0,12"/>
      <Button Content="Start sharing" Height="44" Margin="0,0,0,16" Click="OnStartShare"/>
      <TextBlock Text="Share code" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding CodeDisplay}" FontSize="28" FontFamily="Consolas" Margin="0,4,0,12"/>
      <TextBlock Text="Confirm phrase" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Phrase}" FontSize="18" Margin="0,4,0,12"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Button Content="Yes, same phrase" Margin="0,0,8,0" IsEnabled="{Binding CanConfirm}" Click="OnConfirm" Padding="12,6"/>
        <Button Content="Cancel" Click="OnReject" Padding="12,6"/>
      </StackPanel>
      <ProgressBar Height="10" Value="{Binding ProgressValue}" Maximum="100" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding ProgressText}" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#334"/>
    </StackPanel>

    <StackPanel x:Name="ReceivePanel" Visibility="Collapsed">
      <Button Content="← Back" HorizontalAlignment="Left" Margin="0,0,0,12" Click="OnBackHome" Padding="8,4"/>
      <TextBlock Text="Share code" FontWeight="SemiBold"/>
      <TextBox x:Name="ReceiveCodeBox" Height="36" FontSize="18" FontFamily="Consolas" Margin="0,4,0,12"/>
      <CheckBox x:Name="ReceiveEncryptToggle" Content="Expect MQTT encrypt path" Margin="0,0,0,12"/>
      <Button Content="Connect" Height="44" Margin="0,0,0,16" Click="OnStartReceive"/>
      <TextBlock Text="Confirm phrase" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Phrase}" FontSize="18" Margin="0,4,0,12"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Button Content="Yes, same phrase" Margin="0,0,8,0" IsEnabled="{Binding CanConfirm}" Click="OnConfirm" Padding="12,6"/>
        <Button Content="Cancel" Click="OnReject" Padding="12,6"/>
      </StackPanel>
      <ProgressBar Height="10" Value="{Binding ProgressValue}" Maximum="100" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding ProgressText}" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#334"/>
    </StackPanel>
  </DockPanel>
</Window>
